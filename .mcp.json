{
  "mcpServers": {
    "lisptc-repl": {
      "command": "node",
      "args": [
        "--no-warnings",
        "--experimental-transform-types",
        "apps/mcp/src/server.ts"
      ]
    },
    "fallow": {
      "type": "stdio",
      "command": "npx",
      "args": ["--no", "fallow-mcp"]
    }
  }
}

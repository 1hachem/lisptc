{
  "name": "@lisptc/lsp",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.6.0"
  },
  "bin": {
    "lisptc-lsp": "./src/server.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "node --no-warnings --experimental-transform-types src/server.ts --stdio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@repo/compaction-extension": "workspace:*",
    "@repo/interpreter": "workspace:*",
    "@repo/shared": "workspace:*",
    "@repo/llm-extension": "workspace:*",
    "@repo/mcp-extension": "workspace:*",
    "@repo/memory-extension": "workspace:*",
    "@repo/promises-extension": "workspace:*",
    "@repo/prose-extension": "workspace:*",
    "@repo/repl": "workspace:*",
    "@repo/secrets-extension": "workspace:*",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@repo/tsconfigs": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}

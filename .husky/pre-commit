staged() {
  git diff --cached --name-only --diff-filter=ACMR -z
}

[ -n "$(staged | tr -d '\0')" ] || exit 0

work=$(mktemp -d)
tree="$work/tree"
trap 'rm -rf "$work"' EXIT
export work tree

staged | git checkout-index --prefix="$tree/" -z --stdin
git checkout-index -f --prefix="$tree/" -- biome.json

staged | xargs -0 sh -c '
  set -e
  for f do
    [ -f "$tree/$f" ] && [ ! -L "$tree/$f" ] || continue
    no-comments --stdin-file-path "$f" --fix <"$tree/$f" >"$work/stripped"
    cat "$work/stripped" >"$tree/$f"
    printf "%s\0" "$tree/$f"
  done
' sh >"$work/files"

[ ! -s "$work/files" ] ||
  xargs -0 biome format --write --no-errors-on-unmatched --config-path "$tree" -- <"$work/files"

unmerged=$(staged | xargs -0 sh -c '
  set -e
  for f do
    [ -f "$tree/$f" ] && [ ! -L "$tree/$f" ] || continue
    old=$(git rev-parse ":$f")
    new=$(git hash-object -w --path="$f" -- "$tree/$f")
    [ "$new" != "$old" ] || continue
    mode=$(git --literal-pathspecs ls-files -s -- "$f" | cut -d" " -f1)
    git update-index --cacheinfo "$mode,$new,$f"
    [ -f "$f" ] && [ ! -L "$f" ] || continue
    git cat-file blob "$old" >"$work/base"
    if git merge-file -p -- "$f" "$work/base" "$tree/$f" >"$work/merged"; then
      cat "$work/merged" >"$f"
    else
      printf "  %s\n" "$f"
    fi
  done
' sh)

[ -z "$unmerged" ] || cat >&2 <<EOF
pre-commit: the commit takes the fixed version of these files, but their
unstaged hunks clash with the fix, so the working tree keeps them unfixed:
$unmerged
Run \`pnpm fix:comments\` and \`pnpm format\` before the next commit.
EOF

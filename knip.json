{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.ts"],
      "project": ["scripts/**/*.ts"]
    },
    "apps/api": {
      "project": ["src/**/*.ts"]
    },
    "apps/app": {
      "entry": [
        "src/routes/**/*.tsx",
        "server/routes/**/*.ts",
        "scripts/**/*.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "server/**/*.ts", "scripts/**/*.ts"],
      "ignoreBinaries": ["magick"]
    },
    "apps/lsp": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "apps/mcp": {
      "project": ["src/**/*.ts"]
    },
    "apps/mcp-toolkit": {
      "project": ["src/**/*.ts"]
    },
    "apps/trace-viewer": {
      "entry": ["evals/**/*.eval.ts"],
      "project": ["src/**/*.{ts,tsx}", "evals/**/*.ts"]
    },
    "packages/ai": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/bloub": {
      "entry": ["src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/env": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/evals": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/interpreter": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/llm": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/repl": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/shared": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}

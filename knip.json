{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["pi"],
  "workspaces": {
    "packages/interpreter": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/pi": {
      "entry": ["extensions/*.ts"],
      "project": ["extensions/**/*.ts"]
    }
  }
}

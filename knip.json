{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["pi"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"]
    },
    "packages/env": {
      "entry": ["src/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/interpreter": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/repl": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/pi": {
      "entry": ["extension/*.ts"],
      "project": ["extension/**/*.ts"]
    }
  }
}

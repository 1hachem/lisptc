{
  "permissions": {
    "allow": [
      "Edit(./.claude/canvas/sessions/**)",
      "Edit(./artifacts/**/*.html)"
    ],
    "ask": [
      "Read(./artifacts/**)"
    ],
    "deny": [
      "Agent(Explore)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$PWD}/.agents/hooks/markdown-policy.sh\"",
            "statusMessage": "Checking for new docs"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$PWD}/.agents/hooks/lockfile-policy.sh\"",
            "statusMessage": "Checking for a hand edit of the lockfile"
          }
        ]
      },
      {
        "matcher": "Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$PWD}/.claude/hooks/io-budget.sh\"",
            "statusMessage": "Checking the IO budget"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$PWD}/.agents/hooks/worktree-move.sh\"",
            "statusMessage": "Checking where the worktree goes"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$PWD}/.agents/hooks/worktree-create.sh\"",
            "statusMessage": "Creating the worktree under worktrees/"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$PWD}/.agents/hooks/worktree-remove.sh\"",
            "statusMessage": "Removing the worktree"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$PWD}/.agents/hooks/ci-watch.sh\"",
            "asyncRewake": true,
            "timeout": 2700
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "convex@claude-plugins-official": true,
    "typesafe@typesafe-ai": true
  }
}

{
  "name": "@repo/semantic-extension",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/semantic.ts",
    "./host": "./src/semantic-host.ts"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:calibration": "vitest run --config vitest.calibration.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@repo/interpreter": "workspace:*",
    "@repo/journal-catalog": "workspace:*",
    "@repo/models": "workspace:*",
    "@repo/shared": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/tsconfigs": "workspace:*",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}

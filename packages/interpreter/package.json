{
  "name": "@repo/interpreter",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/lisp.ts",
    "./lisp.ts": "./src/lisp.ts",
    "./repl.ts": "./src/repl.ts",
    "./session-server.ts": "./src/session-server.ts",
    "./grammar.ts": "./src/grammar.ts",
    "./source.ts": "./src/source.ts",
    "./arith.ts": "./src/arith.ts",
    "./mcp.ts": "./src/mcp.ts",
    "./mcp-broker.ts": "./src/mcp-broker.ts",
    "./mcp.toolkit.json": "./mcp.toolkit.json",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "repl": "node --no-warnings --experimental-transform-types src/cli.ts",
    "repl:attach": "node --no-warnings --experimental-transform-types src/cli.ts --attach"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@repo/env": "workspace:*",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@repo/tsconfigs": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0",
    "zod": "^4.4.3"
  }
}

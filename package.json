{
  "name": "lisptc",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "coverage:merge": "node --no-warnings --experimental-transform-types ./scripts/merge-coverage.ts",
    "test:watch": "turbo run test:watch",
    "test:evals": "turbo run test:evals",
    "test:nvim": "bash editors/nvim/tests/run.sh",
    "repl": "pnpm --filter @lisptc/cli repl",
    "repl:attach": "pnpm --silent --filter @lisptc/cli repl:attach",
    "repl:kill": "pnpm --silent --filter @lisptc/cli repl:kill",
    "lint": "biome ci",
    "format": "biome check --write",
    "knip": "knip",
    "fallow": "fallow audit --type-aware",
    "fallow:health": "fallow health --css",
    "fallow:dead-code": "fallow dead-code --type-aware",
    "fallow:dupes": "fallow dupes",
    "boundaries": "turbo boundaries",
    "check:agents": "check-agents-md --checks rules",
    "check:arch": "node --no-warnings --experimental-transform-types ./scripts/check-arch.ts",
    "check:comments": "no-comments",
    "fix:comments": "no-comments --fix",
    "check:docs": "node --no-warnings --experimental-transform-types ./scripts/check-docs.ts",
    "fix:docs": "node --no-warnings --experimental-transform-types ./scripts/check-docs.ts --fix",
    "check:refs": "check-agents-md --checks refs",
    "prepare": "husky"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.2.2",
      "@types/react-dom": "^19.2.2",
      "@better-auth/utils": "0.4.2"
    }
  },
  "knip": {
    "ignoreExportsUsedInFile": {
      "interface": true,
      "type": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@infisical/sdk": "^5.0.2",
    "@repo/env": "workspace:*",
    "check-agents-md": "github:1hachem/check-agents-md#v1",
    "cmd-ts": "^0.15.0",
    "fallow": "^3.28.0",
    "husky": "^9.1.7",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.1.7",
    "knip": "^6.27.0",
    "no-comments": "github:1hachem/no-comments#v1",
    "turbo": "^2.5.0",
    "typescript": "^5.9.3"
  }
}

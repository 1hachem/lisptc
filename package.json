{
  "name": "lisptc",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "repl": "pnpm --filter @repo/interpreter repl",
    "lint": "biome ci",
    "format": "biome check --write",
    "knip": "knip",
    "pi": "pi --provider fireworks --model accounts/fireworks/models/kimi-k3:off",
    "prepare": "husky"
  },
  "pi": {
    "extensions": [
      "./apps/pi/extension/lisp-repl.ts"
    ],
    "skills": [
      "./apps/pi/skills"
    ],
    "prompts": [],
    "themes": []
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@infisical/sdk": "^5.0.2",
    "cmd-ts": "^0.15.0",
    "husky": "^9.1.7",
    "knip": "^6.27.0",
    "tsx": "^4.23.1",
    "turbo": "^2.5.0",
    "typescript": "^5.9.3"
  }
}

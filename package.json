{
	"name": "lisp-pi",
	"type": "module",
	"packageManager": "pnpm@10.28.0",
	"engines": {
		"node": ">=22.6.0"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome ci",
		"repl": "node --no-warnings --experimental-transform-types src/lisp.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepare": "husky"
	},
	"keywords": [
		"pi-package"
	],
	"pi": {
		"extensions": [
			"./extensions"
		],
		"skills": [
			"./skills"
		],
		"prompts": [],
		"themes": []
	},
	"peerDependencies": {
		"@mariozechner/pi-agent-core": "*",
		"@mariozechner/pi-ai": "*",
		"@mariozechner/pi-coding-agent": "*",
		"@mariozechner/pi-tui": "*",
		"@sinclair/typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.12",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@commitlint/types": "^21.2.0",
		"@types/node": "^22.0.0",
		"husky": "^9.1.7",
		"typescript": "^5.9.3",
		"vitest": "^3.0.0"
	}
}

{
  "$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "packages/*/src/**",
      "packages/*/test/**",
      "packages/*/convex/**",
      "packages/*/*.ts",
      "packages/*/*.json",
      "apps/*/src/**",
      "apps/*/server/**",
      "apps/*/test/**",
      "apps/*/evals/**",
      "apps/*/extension/**",
      "apps/*/*.ts",
      "apps/*/*.json",
      "scripts/**/*.ts",
      "*.ts",
      "*.json",
      "!**/node_modules",
      "!.claude",
      "!worktrees",
      "!apps/app/src/routeTree.gen.ts",
      "!apps/trace-viewer/next-env.d.ts",
      "!packages/backend/convex/_generated"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "tab"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUndeclaredDependencies": "error",
        "noUnusedImports": {
          "level": "warn",
          "fix": "safe"
        }
      },
      "style": {
        "noProcessEnv": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@dnd-kit/core": {
                "message": "Drags go through DragLayer in packages/components/src/drag-layer.tsx, on @repo/dragology."
              },
              "@dnd-kit/sortable": {
                "message": "Drags go through DragLayer in packages/components/src/drag-layer.tsx, on @repo/dragology."
              },
              "@dnd-kit/utilities": {
                "message": "Drags go through DragLayer in packages/components/src/drag-layer.tsx, on @repo/dragology."
              },
              "@dnd-kit/modifiers": {
                "message": "Drags go through DragLayer in packages/components/src/drag-layer.tsx, on @repo/dragology."
              }
            }
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/env/src/**",
        "packages/*/test/**",
        "apps/*/test/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/checks/src/trace.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/ui/src/components/ui/**",
        "packages/ui/src/components/ai-elements/**"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useKeyWithClickEvents": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "off"
          },
          "suspicious": {
            "noDocumentCookie": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/bloub/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/dragology/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off",
            "useButtonType": "off"
          },
          "complexity": {
            "useLiteralKeys": "off",
            "useOptionalChain": "off"
          },
          "correctness": {
            "useJsxKeyInIterable": "off"
          },
          "style": {
            "noNonNullAssertion": "off",
            "useTemplate": "off"
          },
          "suspicious": {
            "noExplicitAny": "off",
            "noArrayIndexKey": "off",
            "noGlobalIsNan": "off",
            "noAssignInExpressions": "off",
            "useIterableCallbackReturn": "off",
            "noImplicitAnyLet": "off",
            "noNonNullAssertedOptionalChain": "off"
          }
        }
      }
    }
  ]
}

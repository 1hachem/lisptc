=====================================================================
lisptc — basics: atoms, arithmetic, lists, control flow

Run me:
  pnpm --filter @repo/interpreter exec \
    node --experimental-transform-types src/lisp.ts ../../examples/basics.ptc
=====================================================================
(echo "=== 1. atoms, arithmetic & big numbers ===")

numbers are number | bigint; arithmetic promotes automatically
(echo (+ 1 2 3 4 5))
=> 15
(echo (* 6 7))
=> 42
(echo (/ 22 7))
(echo (- 10 3 2))
=> 5
arithmetic promotes to bigint automatically — exact, no overflow
(echo (* 1000000000000 1000000000000))
=> 1000000000000000000000000 bigint, exact
(echo (< 1 2))
=> t
(echo "=== 2. lists & cons cells ===")

(setq xs (list 1 2 3 4 5))
(echo xs)
(echo (car xs))
=> 1
(echo (cdr xs))
=> 2 3 4 5
(echo (cadr xs))
=> 2
(echo (append xs (list 6 7)))
=> 1 2 3 4 5 6 7
(echo (nreverse (list 1 2 3)))
=> 3 2 1
(echo "=== 3. control flow: cond / when / let / while / dolist ===")

(defun classify (n) (cond ((< n 0) 'negative) ((= n 0) 'zero) (t 'positive)))
(echo (mapcar classify (list -3 0 7)))
=> negative zero positive
(let ((a 3) (b 4)) (echo (+ (* a a) (* b b))))
=> 25
imperative loop with mutation
(setq sum 0)
(dolist (x (list 10 20 30)) (setq sum (+ sum x)))
(echo sum)
=> 60
(setq i 0)
(setq acc nil)
(while (< i 5) (setq acc (cons i acc)) (setq i (+ i 1)))
(echo (nreverse acc))
=> 0 1 2 3 4
(echo "=== 4. association lists (symbolic data) ===")

(setq db '((alice .30) (bob .25) (carol .35)))
(echo (assoc 'bob db))
=> bob . 25
(echo (cdr (assoc 'carol db)))
=> 35
(echo "=== done ===")

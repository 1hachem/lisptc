{
  "description": "Repository lifecycle hooks shared by Codex and Claude.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/markdown-policy.sh\"",
            "statusMessage": "Checking for new docs"
          }
        ]
      },
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/format-patch.sh\"",
            "statusMessage": "Formatting changed files"
          }
        ]
      }
    ]
  }
}
